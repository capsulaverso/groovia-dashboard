{
  "name": "groovia-dashboard",
  "version": "1.0.0",
  "description": "Dashboard Groovia com tema claro/escuro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5000 --host 0.0.0.0",
    "server": "node --require ./telemetry.js node_modules/.bin/tsx server/index.ts",
    "server:no-telemetry": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview --port 5000 --host 0.0.0.0",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/seed.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.66.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/instrumentation-http": "^0.207.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/ws": "^8.18.1",
    "ai": "^5.0.81",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "googleapis": "^164.1.0",
    "groq-sdk": "^0.34.0",
    "mammoth": "^1.11.0",
    "node-cache": "^5.1.2",
    "openai": "^6.7.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
